# Zowe v2.x configuration
# Node version
DEFAULT_NODE_VERSION=16
NODE_VERSION=v16.20.2

# System apps to include in build
SYSTEM_APPS=admin-notification-app web-browser-app

# Marist node path
MARIST_NODE=/ZOWE/node/node-v18.18.2

# zowe-install-packaging branch for version lookup
ZOWE_MANIFEST_BRANCH=v2.x/staging

# Default plugin branch
DEFAULT_PLUGIN_BRANCH=v2.x/staging

# Build method: 'ant' for v2, 'scripts' for v3+
BUILD_METHOD=ant
