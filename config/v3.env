# Zowe v3.x configuration
# Node version
DEFAULT_NODE_VERSION=18
NODE_VERSION=v18.14.2

# System apps to include in build
SYSTEM_APPS=admin-notification-app

# Marist node path
MARIST_NODE=/ZOWE/node/node-v18.18.2

# zowe-install-packaging branch for version lookup
ZOWE_MANIFEST_BRANCH=v3.x/staging

# Default plugin branch
DEFAULT_PLUGIN_BRANCH=v3.x/staging

# Build method: 'ant' for v2, 'scripts' for v3+
BUILD_METHOD=scripts
