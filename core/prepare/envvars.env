# Version-specific settings (DEFAULT_NODE_VERSION, NODE_VERSION, SYSTEM_APPS,
# MARIST_NODE, BUILD_METHOD, etc.) are loaded from config/vN.env by the
# prepare action based on the detected Zowe major version.

# NPM
DEFAULT_NPM_PRIVATE_INSTALL_REGISTRY=https://zowe.jfrog.io/zowe/api/npm/npm-release/

# Nodejs project integration tests
DEFAULT_FVT_ZOSMF_HOST=zzow11.zowe.marist.cloud
DEFAULT_FVT_ZOSMF_PORT=10443
DEFAULT_FVT_SERVER_HOSTNAME=127.0.0.1
DEFAULT_API_ML_DEBUG_PROFILES=default

# Pax packaging
DEFAULT_PAX_PACKAGING_SSH_HOST=zzow11.zowe.marist.cloud
DEFAULT_PAX_PACKAGING_SSH_PORT=65522

GITHUB_PROJECT=zowe
ARTIFACTORY_REPO=libs-snapshot-local/org/zowe/zlux

PAX_HOSTNAME=zzow11.zowe.marist.cloud
PAX_SSH_PORT=65522
